{% extends 'layout.html.twig' %}

{% block title %}imap-archiver{% endblock %}

{% block main %}
    <main class="mx-auto max-w-5xl px-4 py-10">
        <h1 class="text-2xl font-semibold text-slate-900">Witaj w imap-archiver</h1>
        <p class="mt-2 text-slate-600">
            Panel podglądu i zarządzania archiwum pojawi się w kolejnych etapach.
        </p>

        {# Smoke test etapu 4.0: gdy Stimulus wystartuje, `hello_controller.js` podmieni ten
           tekst. Blok znika razem z placeholderem, gdy w 4.3 wejdzie realne UI listy. #}
        {% if app.environment == 'dev' %}
            <p class="mt-6 rounded-lg bg-white px-4 py-3 text-sm text-slate-500 ring-1 ring-slate-200"
               data-controller="hello">
                Stimulus nie wystartował — ten tekst powinien zostać podmieniony.
            </p>
        {% endif %}
    </main>
{% endblock %}
