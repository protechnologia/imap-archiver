{#
  Lewy region: konta użytkownika (etap 4.3a).

  Kolejność narzuca `MailAccountRepository::findForUser()` (`ORDER BY label`) — panel ma wyglądać
  tak samo przy każdym wejściu. „Wszystkie konta" to stan domyślny, a nie osobne konto: brak
  parametru `?account=` znaczy „nie zawężaj".

  Pusta lista kont jest POPRAWNYM stanem (świeży użytkownik, admin bez przypisania), nie błędem.
#}
<nav class="rounded-lg bg-white p-2 text-sm ring-1 ring-slate-200">
    {% if accounts is empty %}
        <div class="px-2 py-3 text-slate-600">
            <p class="font-medium text-slate-900">Nie masz przypisanych kont pocztowych.</p>
            <p class="mt-1">
                {% if is_granted('ROLE_ADMIN') %}
                    Przypisz sobie konto w <a href="{{ path('admin') }}" class="font-medium text-slate-900 underline">panelu admina</a>.
                {% else %}
                    Poproś administratora o dostęp do skrzynki.
                {% endif %}
            </p>
        </div>
    {% else %}
        <a href="{{ path('app_mail_index') }}"
           class="block rounded-md px-3 py-2 {{ selectedAccount is null ? 'bg-slate-900 font-medium text-white' : 'text-slate-700 hover:bg-slate-100' }}">
            Wszystkie konta
        </a>
        {% for account in accounts %}
            <a href="{{ path('app_mail_index', {account: account.id}) }}"
               class="mt-1 block rounded-md px-3 py-2 {{ selectedAccount and selectedAccount.id == account.id ? 'bg-slate-900 font-medium text-white' : 'text-slate-700 hover:bg-slate-100' }}">
                {{ account.label }}
            </a>
        {% endfor %}
    {% endif %}
</nav>
