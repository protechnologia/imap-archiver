{#
  Detal wiadomości — WIDOK TYMCZASOWY etapu 4.2.

  Treść pokazujemy jako `Message.body`, czyli TEKSTOWE ziarno z indeksu (MessageFactory
  preferuje część `text`, HTML jest fallbackiem) — świadomie jako zwykły tekst w `<pre>`.
  Pełny HTML czytany z `.eml`, przepuszczony przez HTMLPurifier i osadzony w `<iframe sandbox>`
  bez `allow-scripts`, wchodzi w 4.5; pobieranie załączników w 4.6.
#}
{% extends 'layout.html.twig' %}

{% block title %}{{ message.subject ?: '(bez tematu)' }} — imap-archiver{% endblock %}

{% block main %}
    <main class="mx-auto max-w-4xl px-4 py-8">
        <a href="{{ path('app_mail_index') }}" class="text-sm text-slate-500 hover:underline">← Wróć do listy</a>

        <h1 class="mt-3 text-2xl font-semibold text-slate-900">{{ message.subject ?: '(bez tematu)' }}</h1>

        <dl class="mt-4 grid grid-cols-[8rem_1fr] gap-y-2 rounded-lg bg-white px-4 py-4 text-sm ring-1 ring-slate-200">
            <dt class="text-slate-500">Od</dt>
            <dd class="text-slate-900">
                {{ message.fromName }}{% if message.fromName and message.fromEmail %} {% endif %}
                {%- if message.fromEmail %}<span class="text-slate-500">&lt;{{ message.fromEmail }}&gt;</span>{% endif %}
            </dd>

            <dt class="text-slate-500">Data</dt>
            <dd class="text-slate-900">{{ message.date ? message.date|date('Y-m-d H:i') : '— (brak nagłówka Date)' }}</dd>

            <dt class="text-slate-500">Konto</dt>
            <dd class="text-slate-900">{{ message.account.label }} · {{ message.folder }}</dd>

            <dt class="text-slate-500">Rozmiar</dt>
            <dd class="text-slate-900">{{ message.size|bytes }}</dd>

            <dt class="text-slate-500">Zweryfikowana</dt>
            <dd class="text-slate-900">{{ message.verified ? 'tak' : 'nie' }}</dd>
        </dl>

        {% if message.attachments|length > 0 %}
            {# Same metadane z indeksu — bajty leżą w `.eml`, pobieranie wchodzi w 4.6. #}
            <div class="mt-4 rounded-lg bg-white px-4 py-4 text-sm ring-1 ring-slate-200">
                <p class="font-medium text-slate-900">Załączniki ({{ message.attachments|length }})</p>
                <ul class="mt-2 space-y-1 text-slate-600">
                    {% for attachment in message.attachments %}
                        <li>{{ attachment.filename }} <span class="text-slate-400">· {{ attachment.size|bytes }} · {{ attachment.mimeType }}</span></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="mt-4 rounded-lg bg-white px-4 py-4 ring-1 ring-slate-200">
            {% if message.body %}
                <pre class="whitespace-pre-wrap break-words font-sans text-sm text-slate-800">{{ message.body }}</pre>
            {% else %}
                <p class="text-sm text-slate-500">Ta wiadomość nie ma treści tekstowej w indeksie.</p>
            {% endif %}
        </div>
    </main>
{% endblock %}
