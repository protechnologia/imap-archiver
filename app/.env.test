###< symfony/framework-bundle ###

###> app/imap ###
# Atrapa klucza dla testów (32 bajty hex) — testy szyfrują poświadczenia tak samo jak dev,
# tylko na własnym kluczu. To NIE jest sekret: żadne prawdziwe hasło tędy nie przechodzi.
MAIL_CRYPTO_KEY=2b4a1cf3ad9e2c7f8b5d0e6a3f1c9d8e7b2a5c4f0d3e6b9a8c1f4d7e0a3b6c9d
###< app/imap ###

# DATABASE_URL świadomie NIE jest tu ustawiony: w Dockerze i tak wygrywa real env var
# z compose.yaml, a nazwę bazy testowej robi `dbname_suffix: _test` z when@test
# w config/packages/doctrine.yaml (czyli `app` → `app_test`).

###> symfony/panther ###
# Recipe ustawia tu `panther`, my dajemy `test` ŚWIADOMIE. Nazwę bazy testowej robi
# `dbname_suffix: _test` z sekcji `when@test` (doctrine.yaml) — środowisko `panther`
# tej sekcji NIE dostaje, więc przeglądarka uderzyłaby w deweloperską bazę `app`
# i test kasowałby realne dane zamiast swoich. Osobne środowisko dałoby się utrzymać
# tylko przez zduplikowanie konfiguracji Doctrine'a pod `when@panther`.
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0

# Bez `--no-sandbox` Chromium nie wystartuje jako root (kontener działa jako root).
PANTHER_NO_SANDBOX=1
PANTHER_CHROME_DRIVER_BINARY=/usr/bin/chromedriver

# Panther NIE stawia własnego serwera — celuje w usługę `php-test` z compose (profil "test").
# Powód: Chromium i tak rozmawia z aplikacją po HTTP przez granicę procesu, więc serwer jest
# potrzebny tak czy inaczej; lepiej, żeby był to TEN SAM stos co w dev (FrankenPHP + Caddy),
# a nie wbudowany `php -S` o innym zachowaniu. Adres to nazwa usługi w sieci Dockera.
# WYMAGA: docker compose --profile test up -d php-test
PANTHER_EXTERNAL_BASE_URI=http://php-test
###< symfony/panther ###
