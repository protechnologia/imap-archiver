# Normalizacja koncow linii: w repo zawsze LF, w working copy wg platformy.
# Stabilizuje churn CRLF<->LF miedzy edycja na Windows a kontenerem Linux.
* text=auto eol=lf

# Pliki binarne - bez konwersji.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf  binary
*.eml  binary
