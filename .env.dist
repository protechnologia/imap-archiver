# Szablon sekretów warstwy Docker Compose (podstawianie ${...} w compose.yaml).
#
# Aby użyć: skopiuj ten plik do /.env (gitignorowany) i uzupełnij wartości.
#   cp .env.dist .env
#
# W DEV ten plik NIE jest potrzebny — compose.yaml ma inline default
# ${DB_PASSWORD:-ChangeMe}, więc bez /.env aplikacja i tak wstaje.
# Root-owy /.env zakładamy dopiero na PROD, by nadpisać te defaulty realnymi sekretami.

# Hasło bazy Postgres. Jedno źródło dla obu stron: zasila POSTGRES_PASSWORD
# (kontener bazy) ORAZ hasło w DATABASE_URL (aplikacja).
DB_PASSWORD=
